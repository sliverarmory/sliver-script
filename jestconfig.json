{
    "rootDir": "src",
    "transform": {
        "^.+\\.(t|j)sx?$": [
            "ts-jest",
            {
                "tsconfig": {
                    "module": "CommonJS",
                    "moduleResolution": "Bundler",
                    "types": ["node", "jest"]
                }
            }
        ]
    },
    "testRegex": "(tests/.*|(\\.|/)(test|spec))\\.(jsx?|tsx?)$",
    "moduleFileExtensions": ["ts", "tsx", "js", "jsx", "json", "node"]
}
