{
  "name": "sliver-script",
  "version": "2.0.0-rc.3",
  "description": "TypeScript/JavaScript Sliver client library",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node ./scripts/clean.mjs lib && tsc -p tsconfig.json",
    "build:e2e": "npm run build && node ./scripts/clean.mjs e2e/dist && tsc -p tsconfig.e2e.json",
    "pb": "npm run protobuf:generate",
    "protobuf:generate": "node ./scripts/protobuf.mjs --write",
    "protobuf:check": "node ./scripts/protobuf.mjs --check",
    "docs": "typedoc --out ./docs/ ./src",
    "test": "jest --config jestconfig.json",
    "test:scripts": "node --test scripts/npm-release/*.test.mjs",
    "test:e2e": "npm run build:e2e && node ./e2e/run.mjs",
    "audit:all": "npm audit",
    "audit:production": "npm audit --omit=dev",
    "pack:dry-run": "node ./scripts/pack-dry-run.mjs",
    "pack:check": "node ./scripts/pack-check.mjs",
    "verify": "npm test && npm run test:scripts && npm run protobuf:check && npm run build && npm run pack:dry-run && npm run pack:check",
    "prepack": "npm run build",
    "prepublishOnly": "npm run audit:all && npm run verify"
  },
  "files": [
    "lib/**/*",
    "src/*.ts",
    "src/events/**/*",
    "src/internal/**/*",
    "src/pb/**/*",
    "scripts/*.mjs",
    "integration.lock.json",
    "protobuf.lock.json",
    "protobuf.sh",
    "tsconfig.json"
  ],
  "keywords": [],
  "author": "moloch",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sliverarmory/sliver-script.git"
  },
  "homepage": "https://github.com/sliverarmory/sliver-script#readme",
  "bugs": {
    "url": "https://github.com/sliverarmory/sliver-script/issues"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "jest": "^30.5.1",
    "ts-jest": "^29.4.12",
    "ts-proto": "2.12.1",
    "typedoc": "^0.28.20",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.14.1",
    "@grpc/grpc-js": "1.14.4",
    "@protobufjs/utf8": "1.1.2",
    "nice-grpc": "^2.1.17",
    "nice-grpc-common": "^2.0.4",
    "protobufjs": "7.6.6",
    "rxjs": "^7.8.2"
  },
  "overrides": {
    "dprint-node": "1.0.8",
    "ts-poet": "6.12.0"
  }
}
